<Bindings>
	<Binding name="Toggle TrinketMenu" description="Toggle TrinketMenu" header="TRINKETMENU">
		TrinketMenu.ToggleFrame(TrinketMenuOptions.DisableToggle=="ON" and TrinketMenu_OptFrame or TrinketMenu_MainFrame)
	</Binding>
	<Binding name="Use Top Trinket" description="Use Top Trinket">
		UseTrinket(13)
	</Binding>
	<Binding name="Use Bottom Trinket" description="Use Bottom Trinket">
		UseTrinket(14)
	</Binding>
	<Binding name="Toggle Current/Last Raid Profile" description="Toggle Current/Last Raid Profile">
		TrinketMenu.ToggleActivePackProfile()
	</Binding>
	<Binding name="Toggle Autoswap on TOP trinket" description="Toggle Autoswap on TOP trinket">
		TrinketMenu.ToggleAutoSwapQueue(0)
	</Binding>
	<Binding name="Toggle Autoswap on BOTTOM trinket" description="Toggle Autoswap on BOTTOM trinket">
		TrinketMenu.ToggleAutoSwapQueue(1)
	</Binding>
</Bindings>
